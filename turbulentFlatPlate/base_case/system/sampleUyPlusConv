// -*- C++ -*-

// Same line as sampleUyPlus, but written at every written time (multiples of
// the controlDict writeInterval) so postpro.py can plot the profile at
// 20/40/60/80/100 % of the run for convergence judgement.

type            sets;
libs            (sampling);
writeControl    writeTime;
interpolationScheme cellPoint;
setFormat       raw;
fields          (rho yPlus U wallShearStress);
sets
{
    x1_profile
    {
        type        face;
        axis        y;
        start       (1 0.0 0.05);
        end         (1 0.1  0.05);
        nPoints     1000;
    }
}
// ************************************************************************* //
