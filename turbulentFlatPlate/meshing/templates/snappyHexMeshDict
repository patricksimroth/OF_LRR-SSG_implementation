FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// addLayers only: the core mesh already comes from gmsh (and, for gmshHex,
// polyDualMesh), so there is nothing to castellate or snap.  Absolute layer
// sizes (relativeSizes false) keep the first-cell height independent of the
// local core cell size.

castellatedMesh false;
snap            false;
addLayers       true;

geometry {}

castellatedMeshControls
{
    maxLocalCells           2000000;
    maxGlobalCells          4000000;
    minRefinementCells      0;
    maxLoadUnbalance        0.1;
    nCellsBetweenLevels     1;
    features                ();
    refinementSurfaces      {}
    resolveFeatureAngle     30;
    refinementRegions       {}
    locationInMesh          @LOCATION_IN_MESH@;
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch    3;
    tolerance       2.0;
    nSolveIter      30;
    nRelaxIter      5;
}

addLayersControls
{
    relativeSizes   false;

    // The `symmetry` patch upstream of the leading edge is layered too, so the
    // stack runs unbroken from the inlet.  Otherwise snappy has to taper the
    // whole stack to nothing at x=0, which leaves concave cells there that
    // converge quietly for ~700 iterations and then blow up the pressure solve.
    // This is why `symmetry` is a plain `patch` with a slip BC rather than a
    // symmetryPlane (snappy refuses to extrude constraint patches) - and a
    // `patch` rather than a `wall`, so it stays out of `wallDist meshWave`.
    layers
    {
        bottomWall
        {
            nSurfaceLayers  @N_PRISMS@;
        }
        symmetry
        {
            nSurfaceLayers  @N_PRISMS@;
        }
    }

    // Stack = first layer + expansion ratio, the ratio solved in Python from
    // the requested overall height (common.stack_expansion_ratio).  Do NOT
    // use snappy's `thickness` keyword: v2512 rejects the stack with it
    // (0% extrusion) where the identical stack via expansionRatio fits.
    firstLayerThickness     @FIRST_LAYER@;
    expansionRatio          @EXPANSION_RATIO@;
    minThickness            @MIN_THICKNESS@;

    nGrow                   0;
    featureAngle            130;
    slipFeatureAngle        30;
    nRelaxIter              5;
    nSmoothSurfaceNormals   3;
    nSmoothNormals          5;
    nSmoothThickness        10;
    maxFaceThicknessRatio   0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle      90;
    nBufferCellsNoExtrude   0;
    nLayerIter              50;
    nRelaxedIter            20;
    nOuterIter              1;
}

meshQualityControls
{
    #include "meshQualityDict"

    relaxed
    {
        maxNonOrtho     75;
    }
}

mergeTolerance 1e-6;

