FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         5000;

deltaT          1;

writeControl    timeStep;

writeInterval   100;

purgeWrite      1;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

functions
{
    minMax
    {
        type            fieldMinMax;
        libs            (fieldFunctionObjects);
        mode            magnitude;
        fields          (U p e epsilon omega k);
        writeControl    timeStep;
        writeInterval   10;
    }
    
    yPlus
    {
        type            yPlus;
        libs            (fieldFunctionObjects);
        writeControl    onEnd;

    }
    solverInfo
    {
        type            solverInfo;
        libs            (utilityFunctionObjects);
        fields          (U p e epsilon omega k);
        // writeControl    onEnd;
        writeInterval   timeStep;
        writeResidualFields yes;
    }
    
    turbulenceFields
    {
        type            turbulenceFields;
        libs            (fieldFunctionObjects);
        fields          (R);
        writeInterval   10;
    }

    stressComponents
    {
        type            turbulenceFields;
        libs            (fieldFunctionObjects);
        writeInterval   10;
        fields          (R epsilon); //devRhoReff
    }

    pressureCoefficient
    {
        type            pressure;
        libs            (fieldFunctionObjects);
        writeControl    onEnd;
        mode            staticCoeff;
        rho             rhoInf;
        rhoInf          1;
        pInf            110000;
        UInf            (44.2 0 0);
    }

    #includeFunc "MachNo"

    wallShearStress
    {
        type            wallShearStress;
        libs            (fieldFunctionObjects);
        writeFields     no;
        executeControl  timeStep;
        writeControl    timeStep;
        writeInterval   10;
    }

    #includeFunc "writeCellCentres"

    #includeFunc "sampleUyPlus"

    yPlus_reference
    {
        type            probes;
        libs            (fieldFunctionObjects);
        fields          (yPlus U wallShearStress);
        probeLocations
        (
            (1 0.0 0.05)
        );
        writeControl    timeStep;
        writeInterval   10;
        // interpolationScheme cellPoint;
    }

    yPlus_reference_2
    {
        type            surfaces;
        libs            (fieldFunctionObjects);
        surfaceFormat   raw;
        fields          (yPlus U wallShearStress);
        // interpolationScheme cellPoint;
        // enabled         true;
        surfaces
        (
            Wall
            {
                type            patch;
                patches         (bottomWall);
                // interpolate     true;
            }
        );
        writeControl    timeStep;
        writeInterval   10;
    }

    probes
    {
        type            probes;
        libs            (fieldFunctionObjects);
        fields          (U);
        probeLocations
        (
            (1.0 0.005 0.05)
            (1.0 0.01 0.05)
            (1.0 0.015 0.05)
        );
        writeControl    timeStep;
        writeInterval   10;
    }
}


