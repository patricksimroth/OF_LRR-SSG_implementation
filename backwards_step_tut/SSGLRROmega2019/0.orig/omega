FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

// omega = k/nu_t with k=2.9e-3 (from base R) and nu_t/nu=0.1 -> 1859 (nu=1.56e-5)
internalField   uniform 1859;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           $internalField;
    }

    outlet
    {
        type            zeroGradient;
    }

    "(lowerWallStartup|upperWallStartup)"
    {
        type            symmetryPlane;
    }

    "(upperWall|lowerWall)"
    {
        type            omegaWallFunction;
        blended         true;
        value           $internalField;
    }

    "(front|back)"
    {
        type            empty;
    }
}


