FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      extrudeMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// gmshHex only.  subsetMesh leaves a half-depth single layer of dual cells;
// re-extruding its exposed `back` patch by the full depth restores the baseline
// z-extent and guarantees exactly one front/back face per cell.

constructFrom   patch;
sourceCase      "@SOURCE_CASE@";
sourcePatches   (back);
exposedPatchName front;
flipNormals     false;

extrudeModel    plane;
nLayers         1;
expansionRatio  1;
thickness       @DEPTH@;

planeCoeffs
{
    thickness   @DEPTH@;
}

mergeFaces      false;
mergeTol        0;

