FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        tolerance       1e-10;
        relTol          0.01; //0.001
        smoother        DICGaussSeidel;
        // nPreSweeps      0; //1
        // nPostSweeps     2;
        // cacheAgglomeration on;
        // agglomerator    faceAreaPair;
        // nCellsInCoarsestLevel 10;
        // mergeLevels     1;
    }

    "(U|R|nuTilda|e)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-10;
        relTol          0.01;
    }

    "(omega|epsilon|k)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-10;
        relTol          0.01;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;


    residualControl
    {
        p               1e-6;
        U               1e-6;
        "(k|epsilon|omega|f|v2|e|R|nuTilda)" 1e-6;
    }


    consistent          yes;
}

relaxationFactors
{
    equations
    {
        U               0.7;
        ".*"            0.6;
    }
}

cache
{
    grad(U);
}


