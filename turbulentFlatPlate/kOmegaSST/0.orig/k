FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

// TMR SST-Vm farfield (flatplate_sst.html): k = 9e-9 * a_inf^2 = 1.087472e-03
// (TMR's equivalent form 1.125*U_inf^2/Re_L gives the same value for this
// case).  Corresponds to Tu = 0.039 %.
internalField   uniform 1.087472e-03;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           $internalField;
    }

    outlet
    {
        type            zeroGradient;
    }

    topWall
    {
        type            zeroGradient;
    }

    // TMR (sst.html): k_wall = 0.  kqRWallFunction is zeroGradient, a high-Re
    // wall-function BC, wrong for this wall-resolved mesh.
    bottomWall
    {
        type            fixedValue;
        value           uniform 0;
    }

    symmetry
    {
        type            slip;
    }

    frontAndBack
    {
        type            empty;
    }
}


