FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         steadyState;
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    default         none;

    div(phi,U)      bounded Gauss linearUpwind grad(U);  //mehr gauss linear
    // div(phi,U)      bounded Gauss upwind;
    div(phid,p)         bounded Gauss linear;
    // div(phi,p)      bounded Gauss upwind;
    div(phi,p)      bounded Gauss linear;
    
    // div(phi,nuTilda)  bounded Gauss limitedLinear 1; //SA

    div(phi,e)          bounded Gauss linear;
    div(R)              Gauss linear;		//simpleFoam
    div(phi,Ekp)        bounded Gauss linear;
    // turbulence          bounded Gauss limitedLinear 1;
    turbulence        bounded Gauss limitedLinear 1;
    div(phi,k)          $turbulence;
    div(phi,epsilon)    $turbulence;
    div(phi,omega)      $turbulence;
    div(phi,R)          $turbulence;		//SSG
    // div(devRhoReff)     Gauss linear;    //rhoSimpleFoam
    div((rho*R))        Gauss linear;		//SSG
    div(((rho*nuEff)*dev2(T(grad(U)))))      Gauss linear;
    div((nuEff*dev2(T(grad(U)))))                      Gauss linear;//linear
    div(((rho*(thermo:mu|rho))*dev2(T(grad(U)))))      Gauss linear;		//SSG
    div((nu*dev2(T(grad(U)))))                      Gauss linear;		//simpleFoam

}

laplacianSchemes
{
    default         Gauss linear uncorrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         uncorrected; //uncorrected oder orthogonal
}

wallDist
{
    method          meshWave;
}


