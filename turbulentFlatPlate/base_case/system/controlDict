        writeControl    onEnd;
    }

    integralCf
    {
        type            forceCoeffs;
        libs            (forces);
        patches         (bottomWall);
        p               p;
        U               U;
        rho             rho;
        rhoInf          1.2745;
        dragDir         (1 0 0);
        liftDir         (0 1 0);
        pitchAxis       (0 0 1);
        CofR            (0 0 0);
        magUInf         69.4;
        lRef            2;
        Aref            0.1;
        coefficients    (Cd);
        writeFields     no;
        executeControl  timeStep;
        executeInterval 1;
        writeControl    writeTime;
    }

    integralCfStop
    {
        type            runTimeControl;
        libs            (utilityFunctionObjects);
        writeControl    timeStep;
        writeInterval   1;
        // Both conditions carry the SAME groupID, so the run stops only when
        // BOTH hold.  A condition without a groupID defaults to -1, which
        // runTimeControl treats as sufficient on its own (ungrouped conditions
        // are ORed, not ANDed) - the residual gate would then do nothing.
        //
        // Each is wrapped in `consecutive` (src/consecutiveCondition): it is
        // satisfied only after the wrapped condition held for nIter calls in
        // a row, and one failing call resets its count.  Both wrappers count
        // every iteration, so the group is met exactly when the average AND
        // the residual gate have held together for the last 100 iterations.
        // Without the hold the criterion fired on single-iteration dips:
        // where an oscillating Cd crosses its own trailing mean, delta is ~0
        // for a few iterations and the p residual can dip below 1e-4 there
        // (gmshTri nPrisms30 stopped at 1143 inside a +-1 % limit cycle).
        // Replayed on 57 Cd histories: 4 false stops without the hold, 0
        // with it, at a cost of 0-300 iterations.
        conditions
        {
            integralCfAverage
            {
                type            consecutive;
                nIter           100;
                groupID         1;
                condition
                {
                    type            average;
                    functionObject  integralCf;
                    fields          (Cd);
                    // delta = |300-iteration window mean - current Cd|,
                    // absolute.  The mean lags the current value, so
                    // delta ~ 150*dCd/diter: this measures the drift RATE,
                    // not the distance to the asymptote.  Cd ~ 5.7e-3 here,
                    // so 1e-6 is 1.8e-4 relative and stops every mesh within
                    // ~0.1 % of its converged Cd.
                    // NOTE: absolute, so it is tied to Aref in integralCf -
                    // halve Aref and this tolerance loosens by 2x.
                    tolerance       1e-6;
                    window          300;
                    windowType      exact;
                    // Must be >= window (a partly filled window gives
                    // delta = 0 at iteration 1) and past the Cd overshoot:
                    // Cd peaks and turns over at ~700-850 on all four meshes,
                    // and where the curve crosses its own trailing mean delta
                    // collapses to zero.  The condition first reports true
                    // at iteration 1003, so the earliest stop is 1102.
                    nIterStartUp    1000;
                }
            }
            // Guards the criterion against turning-point dips: at the
            // blockMesh dip the p residual is 1.9e-3, far above this gate,
            // while the genuinely converged stops sit at 1e-7 .. 2e-5.
            pResidual
            {
                type            consecutive;
                nIter           100;
                groupID         1;
                condition
                {
                    type            equationInitialResidual;
                    fields          (p);
                    value           1e-4;
                    mode            minimum;
                }
            }
            // Guards against slow turnovers.  On fine meshes (blockMesh n_y
            // 386) Cd overshoots and turns over so slowly that the average
            // reads ~0 for hundreds of iterations while p is already below
            // 1e-4: stock SA stopped at 3240 with Cd +2.7 %.  Ux is the
            // separating residual: 2e-5 at that false stop, <= 5e-7 at every
            // genuine core_refinement stop.  Replayed: the false stop moves
            // to 8892 (+0.24 %), all other replayed stops are unchanged.
            // U.component(0) = Ux only; plain (U) takes the max over components and
            // Uy sits at ~1e-5 even when converged.
            UxResidual
            {
                type            consecutive;
                nIter           100;
                groupID         1;
                condition
                {
                    type            equationInitialResidual;
                    fields          (U.component(0));
                    value           2e-6;
                    mode            minimum;
                }
            }
        }
        satisfiedAction end;
    }
}


