FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

// epsilon = Cmu * k * omega with the TMR farfield k and omega
// (1.087472e-03, 8705.28).  Only the epsilon-based RSM variants (SSG, LRR)
// use this field; TMR prescribes no epsilon-based flat-plate BCs.
internalField   uniform 0.852008;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           $internalField;
    }

    outlet
    {
        type            zeroGradient;
    }

    topWall
    {
        type            zeroGradient;
    }

    bottomWall
    {
        type            epsilonWallFunction;
        lowReCorrection on;
        value           $internalField;
    }

    symmetry
    {
        type            slip;
    }

    frontAndBack
    {
        type            empty;
    }
}


