FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     rhoSimpleFoam;

libs
(
    "/home/patrick/OpenFOAM/patrick-v2512/run/test_cases/src/SSGLRROmega2019/lib/libSSGLRROmega2019Compressible.so"
    "/home/patrick/OpenFOAM/patrick-v2512/run/test_cases/src/SpalartAllmarasSALSA/lib/libSpalartAllmarasSALSACompressible.so"
);

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         8000;

deltaT          1;

writeControl    timeStep;

writeInterval   100;

purgeWrite      1;

writeFormat     binary;

writePrecision  10;

runTimeModifiable true;

functions
{
    minMax
    {
        type            fieldMinMax;
        libs            (fieldFunctionObjects);
        mode            magnitude;
        fields          (U p e epsilon omega k);
        writeControl    timeStep;
        writeInterval   10;
    }
    
    yPlus
    {
        type            yPlus;
        libs            (fieldFunctionObjects);
        patches         (bottomWall);
        writeFields     yes;
        writeControl    writeTime;
    }
    solverInfo
    {
        type            solverInfo;
        libs            (utilityFunctionObjects);
        fields          (U p e epsilon omega k);
        // Every step: postpro.py reads the residual history from solverInfo.dat.
        // No residual fields - they create a time directory per iteration
        // (~3000 dirs, several GB per case) that purgeWrite never removes.
        writeControl    timeStep;
        writeInterval   1;
        writeResidualFields no;
    }
    
    turbulenceFields
    {
        type            turbulenceFields;
        libs            (fieldFunctionObjects);
        fields          (R);
        writeControl    writeTime;
    }

    stressComponents
    {
        type            turbulenceFields;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
        fields          (R epsilon); //devRhoReff
    }

    pressureCoefficient
    {
        type            pressure;
        libs            (fieldFunctionObjects);
        writeControl    onEnd;
        mode            staticCoeff;
        rho             rhoInf;
        rhoInf          1;
        pInf            110000;
        UInf            (69.4 0 0);
    }

    #includeFunc "MachNo"

    wallShearStress
    {
        type            wallShearStress;
        libs            (fieldFunctionObjects);
        patches         (bottomWall);
        writeFields     yes;
        writeControl    writeTime;
    }

    #includeFunc "writeCellCentres"

    #includeFunc "sampleUyPlus"

    #includeFunc "sampleUyPlusConv"

    #includeFunc "samplePlate"

    #includeFunc "sampleProfile"

    yPlus_reference_2
    {
        type            surfaces;
        libs            (fieldFunctionObjects);
        surfaceFormat   raw;
        fields          (yPlus U wallShearStress);
        // interpolationScheme cellPoint;
        // enabled         true;
        surfaces
        (
            Wall
            {
                type            patch;
                patches         (bottomWall);
                // interpolate     true;
            }
        );
        // Final time only: cf_validation.py reads just the latest time dir
        // (every 10 iterations left ~300 dirs / 16 MB per run).
        writeControl    onEnd;
    }

    integralCf
    {
        type            forceCoeffs;
        libs            (forces);
        patches         (bottomWall);
        p               p;
        U               U;
        rho             rho;
        rhoInf          1.2745;
        dragDir         (1 0 0);
        liftDir         (0 1 0);
        pitchAxis       (0 0 1);
        CofR            (0 0 0);
        magUInf         69.4;
        lRef            2;
        Aref            0.1;
        coefficients    (Cd);
        writeFields     no;
        executeControl  timeStep;
        executeInterval 1;
        writeControl    writeTime;
    }

    integralCfStop
    {
        type            runTimeControl;
        libs            (utilityFunctionObjects);
        writeControl    timeStep;
        writeInterval   1;
        // Both conditions carry the SAME groupID, so the run stops only when
        // BOTH hold.  A condition without a groupID defaults to -1, which
        // runTimeControl treats as sufficient on its own (ungrouped conditions
        // are ORed, not ANDed) - the residual gate would then do nothing.
        conditions
        {
            integralCfAverage
            {
                type            average;
                functionObject  integralCf;
                fields          (Cd);
                // delta = |300-iteration window mean - current Cd|, absolute.
                // The mean lags the current value, so delta ~ 150*dCd/diter:
                // this measures the drift RATE, not the distance to the
                // asymptote.  Cd ~ 5.7e-3 here, so 1e-6 is 1.8e-4 relative
                // and stops every mesh within 0.07 % of its converged Cd.
                // NOTE: absolute, so it is tied to Aref in integralCf - halve
                // Aref and this tolerance loosens by 2x.
                tolerance       1e-6;
                window          300;
                windowType      exact;
                // Must be >= window (a partly filled window gives delta = 0 at
                // iteration 1) and past the Cd overshoot: Cd peaks and turns
                // over at ~700-850 on all four meshes, and where the curve
                // crosses its own trailing mean delta collapses to zero.  On
                // blockMesh that dip lasts a single iteration (855) at +6.3 %
                // Cd error, which is exactly where nIterStartUp 500 would stop.
                nIterStartUp    1000;
                groupID         1;
            }
            // Guards the criterion against those turning-point dips: at the
            // blockMesh dip the p residual is 1.9e-3, far above this gate,
            // while the genuinely converged stops sit at 1e-6 .. 2e-5.
            pResidual
            {
                type            equationInitialResidual;
                fields          (p);
                value           1e-4;
                mode            minimum;
                groupID         1;
            }
        }
        satisfiedAction end;
    }
}


