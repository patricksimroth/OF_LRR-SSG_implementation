FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        // DIC: ~1.7x faster per iteration than GaussSeidel on the
        // high-aspect-ratio blockMesh (500-iter benchmark), equal on gmshHex
        smoother        DIC;
        tolerance       1e-8;
        relTol          0.05; //0.001
        // nPreSweeps      0; //1
        // nPostSweeps     2;
        // cacheAgglomeration on;
        // agglomerator    faceAreaPair;
        // nCellsInCoarsestLevel 10;
        // mergeLevels     1;
    }

    "(U|R|nuTilda|e)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-9;
        relTol          0.05;
    }

    "(omega|epsilon|k)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-9;
        relTol          0.01;
    }
}

SIMPLE
{
    // 0: blockMesh is fully orthogonal and the gmsh/snappy cores stay below
    // ~35 deg (avg ~3 deg).  With 1, the extra p solve cost blockMesh ~83 GAMG
    // iterations per step on its high-aspect-ratio cells (~2.5x total runtime).
    nNonOrthogonalCorrectors 0;
    consistent          yes;


    residualControl
    {
        p               1e-8;
        U               1e-8;
        "(k|epsilon|omega|f|v2|e|R|nuTilda)" 1e-8;
    }


}

relaxationFactors
{
    equations
    {
        U               0.8;
        ".*"            0.6;
    }
}

cache
{
    grad(U);
}


